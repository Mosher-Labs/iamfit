{
  "name": "iamfit",
  "private": true,
  "description": "Statically analyzes Terraform HCL to determine required AWS IAM actions",
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba",
  "engines": {
    "node": "26.13.1"
  },
  "workspaces": [
    "core",
    "cli",
    "worker"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
