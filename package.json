{
  "name": "iamfit",
  "private": true,
  "description": "Statically analyzes Terraform HCL to determine required AWS IAM actions",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "engines": {
    "node": ">=24.19.0"
  },
  "workspaces": [
    "core",
    "cli",
    "worker"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
