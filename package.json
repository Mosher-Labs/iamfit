{
  "name": "iamfit",
  "private": true,
  "description": "Statically analyzes Terraform HCL to determine required AWS IAM actions",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "core",
    "cli",
    "worker"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
