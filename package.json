{
  "name": "iamfit",
  "private": true,
  "description": "Statically analyzes Terraform HCL to determine required AWS IAM actions",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "engines": {
    "node": ">=24.19.0"
  },
  "workspaces": [
    "core",
    "cli",
    "worker"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
